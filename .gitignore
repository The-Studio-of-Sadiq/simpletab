node_modules/
/packages/*/dist/
/packages/*/lib/
/packages/*/src-gen/
/packages/app/gen-esbuild.*.mjs
/packages/app/.browser_modules/
/packages/app/plugins/
/packages/app/resources/public-site/
coverage/
# Saved copies of the curated extensions for e2e:extensions (npm run fetch:extensions).
/tools/e2e/fixtures/extensions/
*.tsbuildinfo
.env
.env.*
*.simpletab
*.simpletab.db
*.simpletab.db-*
# Compiled output must never land in core's source folder (agents running tsc by hand).
/packages/core/src/**/*.js
/packages/core/src/**/*.js.map
/packages/core/src/**/*.d.ts
