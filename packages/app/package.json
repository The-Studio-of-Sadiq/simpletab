{
  "name": "@simpletab/app",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "lib/backend/electron-main.js",
  "scripts": {
    "prebuild": "npm run build -w @simpletab/host && npm run build -w @simpletab/tab-ui",
    "build": "theia build --mode development",
    "start": "theia start",
    "rebuild": "theia rebuild:electron --modules native-keymap drivelist keytar better-sqlite3",
    "rebuild:node": "theia rebuild:browser --modules native-keymap drivelist keytar better-sqlite3"
  },
  "dependencies": {
    "@simpletab/host": "*",
    "@simpletab/tab-ui": "*",
    "@theia/core": "1.77.0",
    "@theia/electron": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/workspace": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@theia/cli": "1.77.0",
    "electron": "44.9.1"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "SimpleTab",
        "electron": {
          "appUserModelId": "app.simpletab.desktop"
        }
      }
    },
    "backend": {
      "config": {}
    }
  }
}
