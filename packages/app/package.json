{
  "name": "@simpletab/app",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "main": "lib/backend/electron-main.js",
  "scripts": {
    "prebuild": "npm run fetch:public-site && npm run build -w @simpletab/host && npm run build -w @simpletab/tab-ui",
    "fetch:public-site": "node scripts/fetch-public-site.mjs",
    "download:plugins": "theia download:plugins --rate-limit 15 --parallel false",
    "build": "node scripts/ensure-plugins.mjs && theia build --mode development",
    "start": "theia start",
    "rebuild": "theia rebuild:electron --modules native-keymap drivelist keytar better-sqlite3",
    "rebuild:node": "theia rebuild:browser --modules native-keymap drivelist keytar better-sqlite3"
  },
  "dependencies": {
    "@simpletab/host": "*",
    "@simpletab/tab-ui": "*",
    "@theia/core": "1.77.0",
    "@theia/electron": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/plugin-ext": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/scm": "1.77.0",
    "@theia/terminal": "1.77.0",
    "@theia/workspace": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@theia/cli": "1.77.0",
    "electron": "44.9.1"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "SimpleTab",
        "preferences": {
          "files.exclude": {
            "**/.git": true,
            "**/.svn": true,
            "**/.hg": true,
            "**/CVS": true,
            "**/.DS_Store": true,
            "**/*.simpletab.db-*": true,
            "**/collab": true
          }
        },
        "electron": {
          "appUserModelId": "app.simpletab.desktop",
          "windowOptions": {
            "icon": "resources/icons/icon.png"
          },
          "splashScreenOptions": {
            "content": "resources/splash/splash.html",
            "width": 560,
            "height": 340,
            "minDuration": 600,
            "maxDuration": 30000
          }
        }
      }
    },
    "backend": {
      "config": {}
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix"
  }
}
