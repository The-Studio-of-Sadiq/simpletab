{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "jsx": "react",
    "types": ["vitest/globals"],
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../core/src/*"],
      "@simpletab/core/*": ["../core/src/*"],
      "@simpletab/host/lib/common/*": ["../host/src/common/*"],
      "@simpletab/extensions/lib/common/*": ["../extensions/src/common/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
