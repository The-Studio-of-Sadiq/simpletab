{
  "name": "simpletab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/host/tsconfig.json --noEmit && tsc -p packages/tab-ui/tsconfig.json --noEmit",
    "lint": "eslint . && npm run typecheck",
    "port-check": "node tools/port-check.mjs",
    "i18n:check": "node packages/tab-ui/scripts/i18n-check.mjs",
    "port-from-crabbytab": "node tools/port-from-crabbytab.mjs",
    "tabbycat-diff": "vitest run --project tabbycat-diff",
    "determinism": "vitest run --project core packages/core/test/determinism",
    "determinism:update": "node tools/update-draw-hashes.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/papaparse": "^5.3.15",
    "@xmldom/xmldom": "^0.9.8",
    "eslint": "9.39.5",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
